# 適正体重計算ツール - 環境変数設定例
# このファイルをコピーして .env.local を作成し、実際の値を設定してください。
# cp .env.local.example .env.local

# ============================================================
# Anthropic Claude API キー（必須）
# ============================================================
# Claude APIキーを取得してここに設定してください。
# 取得先: https://console.anthropic.com/
# 注意: このキーは絶対にクライアント側のコードに露出させないでください。
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================================
# サイトURL（任意）
# ============================================================
# Xシェア機能で使用するサイトURLです。
# 本番デプロイ時はVercelが自動で設定するため、通常は設定不要です。
# NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app
